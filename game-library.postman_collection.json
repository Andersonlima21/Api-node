{
  "info": {
    "name": "Game Library API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "gameId",
      "value": ""
    },
    {
      "key": "animeId",
      "value": ""
    },
    {
      "key": "musicId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "Listar todos os jogos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/games"
          }
        },
        {
          "name": "Buscar jogo por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/games/{{gameId}}"
          }
        },
        {
          "name": "Criar jogo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/games",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Last of Us Part II\",\n  \"genre\": [\"Ação\", \"Aventura\"],\n  \"platform\": [\"PS4\", \"PS5\"],\n  \"developer\": \"Naughty Dog\",\n  \"releaseYear\": 2020,\n  \"rating\": 9.5,\n  \"coverUrl\": \"https://upload.wikimedia.org/wikipedia/en/4/4f/TLOU_P2_Box_Art_Full.jpg\"\n}"
            }
          }
        },
        {
          "name": "Atualizar jogo",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/games/{{gameId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9.8\n}"
            }
          }
        },
        {
          "name": "Deletar jogo",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/games/{{gameId}}"
          }
        }
      ]
    },
    {
      "name": "Animes",
      "item": [
        {
          "name": "Listar todos os animes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/animes"
          }
        },
        {
          "name": "Buscar anime por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/animes/{{animeId}}"
          }
        },
        {
          "name": "Criar anime",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/animes",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fullmetal Alchemist: Brotherhood\",\n  \"genre\": [\"Action\", \"Adventure\", \"Fantasy\"],\n  \"releaseYear\": 2009,\n  \"rating\": 9.1,\n  \"coverUrl\": \"https://example.com/fmab.jpg\"\n}"
            }
          }
        },
        {
          "name": "Atualizar anime",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/animes/{{animeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9.5\n}"
            }
          }
        },
        {
          "name": "Deletar anime",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/animes/{{animeId}}"
          }
        }
      ]
    },
    {
      "name": "Musics",
      "item": [
        {
          "name": "Listar todas as músicas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/musics"
          }
        },
        {
          "name": "Buscar música por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/musics/{{musicId}}"
          }
        },
        {
          "name": "Criar música",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/musics",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lisbon\",\n  \"genre\": [\"Heavy Metal\", \"Power Metal\"],\n  \"releaseYear\": 2022\n}"
            }
          }
        },
        {
          "name": "Criar várias músicas",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/musics",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"title\": \"Lisbon\",\n    \"genre\": [\"Heavy Metal\", \"Power Metal\"],\n    \"releaseYear\": 2022\n  },\n  {\n    \"title\": \"Carry On\",\n    \"genre\": [\"Power Metal\"],\n    \"releaseYear\": 1998\n  },\n  {\n    \"title\": \"Rebirth\",\n    \"genre\": [\"Heavy Metal\", \"Progressive Metal\"],\n    \"releaseYear\": 2001\n  }\n]"
            }
          }
        },
        {
          "name": "Atualizar música",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/musics/{{musicId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9.5\n}"
            }
          }
        },
        {
          "name": "Deletar música",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/musics/{{musicId}}"
          }
        }
      ]
    }
  ]
}
